{
  "name": "tweet-manager",
  "version": "0.5.5",
  "description": "Twitter/X 트윗을 쉽게 정리하고 삭제할 수 있는 데스크톱 앱",
  "author": "ybbarng",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --write",
    "check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -n next,electron -k \"next dev\" \"wait-on http://localhost:${PORT:-3000} && pnpm run electron:compile && electron .\"",
    "icon:build": "node scripts/build-icon.js",
    "electron:build": "pnpm run icon:build && next build && pnpm run electron:compile && electron-builder",
    "electron:publish": "pnpm run icon:build && next build && pnpm run electron:compile && dotenv -e .env.local -- electron-builder --publish always",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "release": "node scripts/release.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.7.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "wretch": "^3.0.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "com.tweet-manager.app",
    "productName": "Tweet Eraser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "resources/**/*",
      "!**/node_modules/**/@next/**",
      "!**/node_modules/**/next/**",
      "!**/node_modules/**/react/**",
      "!**/node_modules/**/react-dom/**",
      "!**/node_modules/**/@tanstack/**",
      "!**/node_modules/**/@radix-ui/**",
      "!**/node_modules/**/tailwindcss/**",
      "!**/node_modules/**/lucide-react/**",
      "!**/node_modules/**/class-variance-authority/**",
      "!**/node_modules/**/clsx/**",
      "!**/node_modules/**/tailwind-merge/**",
      "!**/node_modules/**/@biomejs/**",
      "!**/node_modules/**/sharp/**",
      "!**/node_modules/**/@img/**",
      "!**/node_modules/**/vitest/**",
      "!**/node_modules/**/typescript/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "ybbarng",
      "repo": "tweet-manager"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": "biome check --write"
  }
}
